MODE=tdm
PORT=3000
HOST=0.0.0.0
MAX_PLAYERS=100
WORLD_SEED=12345
WORLD_SIZE=256
WORLD_HEIGHT=64
# Map IDs from public/maps/catalog.json; ubercube is the native generated terrain.
MAP=ubercube
# Empty rotates through the full catalogue, including ubercube.
MAP_ROTATION=
# 15 minutes; 0 disables automatic rotation.
ROUND_SECONDS=900
# Client build: empty keeps same-origin locally; on Vercel it enables singleplayer only.
# Set an HTTPS game server origin to enable multiplayer on Vercel.
PUBLIC_GAME_SERVER_URL=
# Bun server: exact frontend origins, comma-separated (no paths or wildcards).
ALLOWED_ORIGINS=
