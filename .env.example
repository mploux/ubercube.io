MODE=tdm
PORT=3000
HOST=0.0.0.0
MAX_PLAYERS=100
WORLD_SEED=12345
WORLD_SIZE=256
WORLD_HEIGHT=64
# 0 keeps the round open until its final product rules are chosen.
ROUND_SECONDS=0
# Client build: empty keeps same-origin locally; on Vercel it enables singleplayer only.
# Set an HTTPS game server origin to enable multiplayer on Vercel.
PUBLIC_GAME_SERVER_URL=
# Bun server: exact frontend origins, comma-separated (no paths or wildcards).
ALLOWED_ORIGINS=
