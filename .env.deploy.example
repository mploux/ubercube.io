# Optional LOCAL credential settings for release tooling. Never commit real values.
# Bun reads .env.local automatically; this example is not loaded by itself.
# Obtain a Vercel token through your account's authorized access mechanism.
VERCEL_TOKEN=
# Alternative: absolute path to a private JSON file with a token field.
# Existing workstation fallback: .runtime/vercel-cli/auth.json
VERCEL_AUTH_FILE=
# SSH/SCP use the dedicated ubercube-prod OpenSSH profile in ~/.ssh/config.
# Check access with bun run doctor --server; the private key stays outside this repo.
# Do not put SSH passwords in this file, shell arguments, or repository files.
